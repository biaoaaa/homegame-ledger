{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homegame-ledger",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://yjdetmdmrjuthyrkbopu.supabase.co"
  },
  "observability": {
    "enabled": true
  }
}
